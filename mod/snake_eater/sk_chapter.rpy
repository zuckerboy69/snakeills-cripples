label sk_scene_s08_council:
    $ sk_scene("school_council_ni", "drama", [], "Snake Eater")
    $ sk_sfx("door_creak")
    "Night. The student council room. Snake moves between the desks like he was never there."
    "The drawer marked \"NOT BLUEPRINTS\" contains blueprints. A thousand pages. On the cover, in English: \"A BILL to establish a clear and comprehensive prohibition of discrimination on the basis of disability.\""
    sk_snake "The Americans with Disabilities Act... drafted in 1964. In Russian. With footnotes."
    call sk_codec_c05_cliffhanger
    $ sk_sfx("switch")
    "The lights come on."
    $ sk_present = ['shizune', 'misha', 'emi', 'hanako', 'lilly', 'rin']
    $ sk_show("shizune", "happy", "center")
    $ sk_expr("shizune", "happy")
    ssh "Good evening, Nakai. Or should I say... Snake."
    $ sk_show("misha", "happy", "right")
    $ sk_expr("misha", "happy")
    mi "Shicchan says she read your file! And your lips! Wahahaha~!"
    $ sk_show("emi", "happy", "left")
    $ sk_expr("emi", "happy")
    emi "Told you I'm fast. I beat you here by six minutes."
    $ sk_expr("lilly", "neutral")
    li "We heard you come in. Well, I did."
    $ sk_expr("hanako", "neutral")
    ha "W-we've... been expecting you... for twenty-six years. Th-that's how long... the plan takes."
    $ sk_expr("rin", "neutral")
    rin "I painted you into the mural already. You're the man at the bottom of the ramp, looking up."
    $ sk_expr("shizune", "happy")
    ssh "The Cobra Unit is retired. Meet the Kerb Unit."
    sk_snake "Kept you waiting, huh?"
    "To be continued."
    return

# The chapter, in scene order.
label snake_eater_chapter:
    call sk_scene_s01_insertion
    call sk_scene_s02_gate
    call sk_scene_s03_hallway
    call sk_scene_s04_classroom
    call sk_scene_s05_track
    call sk_scene_s06_library
    call sk_scene_s07_roof
    call sk_scene_s08_council
    return
